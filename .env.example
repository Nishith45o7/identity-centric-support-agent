# ==============================================================================
# CONTEXTIS PLATFORM CONFIGURATION TEMPLATE
# ==============================================================================

# [Runtime & Server]
# Type: Optional (Defaults to 3000 / development)
# Classification: Public
PORT=3000
NODE_ENV=development

# [CORS & Host Allowlist]
# Type: Required in Production (Comma-separated origins allowed to make authenticated session requests)
# Classification: Public / Configuration
CORS_ORIGIN=http://localhost:3000

# [Platform Administrative Control]
# Type: Required for Platform Admin Access (Comma-separated admin emails)
# Classification: Secret / Restricted
PLATFORM_ADMIN_EMAILS=admin@contextis.test

# [Database Storage Engine]
# Type: Optional in Dev/Test (Falls back to local SQLite), REQUIRED in Production Clustered Deployments
# Classification: Secret (Connection string with credentials)
# Example: postgresql://user:password@ep-cool-lake-12345.us-east-2.aws.neon.tech/contextis?sslmode=require
DATABASE_URL=

# [Security Pepper for API Keys]
# Type: REQUIRED in Production (Must be a 32+ character random string; default dev value rejected in prod)
# Classification: Secret (Never expose)
API_KEY_PEPPER=

# [Billing & Stripe Webhook Secret]
# Type: REQUIRED in Production for Stripe webhook verification
# Classification: Secret (Webhook HMAC signing secret)
BILLING_WEBHOOK_SECRET=

# [Internal Platform Support API Key]
# Type: REQUIRED in Production for platform-to-platform endpoints
# Classification: Secret
SUPPORT_API_KEY=

# [Frontier AI & Generative Inference (Groq)]
# Type: Optional (Falls back to deterministic local troubleshooting engine if missing)
# Classification: Secret
GROQ_API_KEY=

# [Contextis Memory Bank (Hindsight Vector Memory)]
# Type: Optional (Falls back to local cryptographic in-memory bank if missing)
# Classification: Secret
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# [Memory Feature Flag]
# Type: Optional (on | off, defaults to on)
# Classification: Public / Configuration
MEMORY_MODE=on

