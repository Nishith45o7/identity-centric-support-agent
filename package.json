{
  "name": "identity-centric-support",
  "version": "1.0.0",
  "description": "Identity-centric support agent with persistent memory and secure API patterns.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "validate:config": "node -e \"const { config, validateRuntimeConfig } = require('./src/config'); try { validateRuntimeConfig(config); console.log('Runtime config validation passed.'); } catch (error) { console.error(error.message); process.exit(1); }\"",
    "test": "jest --runInBand",
    "docker:build": "docker build -t identity-centric-support .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env identity-centric-support"
  },
  "keywords": [
    "support-agent",
    "identity-memory",
    "express",
    "chatbot"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.5.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "swagger-ui-dist": "^5.33.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0"
  }
}
